		<db:update doc:name="Update" doc:id="1ea53724-a7a5-4eab-8510-2b647693d316" config-ref="Database_Config">
			<db:sql ><![CDATA[UPDATE incidente SET estado = 'RESUELTO' WHERE id = :incidente_id]]></db:sql>
			<db:input-parameters ><![CDATA[#[{"incidente_id": vars.incidenteId}]]]></db:input-parameters>
