			</when>
			<otherwise >
				<raise-error doc:name="Estado del incidente no resuelto" doc:id="1a771a3a-b84c-44e2-b0bf-a6f588b2e6b9" type="ANY" description="Estado del incidente no resuelto"/>
			</otherwise>
		</choice>
		<set-payload value='#[%dw 2.0&#10;output application/xml&#10;ns ns0 http://www.example.org/ServicioProcesoCierreIncidente/&#10;---&#10;{&#10;    body: {&#10;        ns0#CerrarResponse: {&#10;            ns0#incidenteCerrado: true,&#10;            ns0#error: ""&#10;        }&#10;    }&#10;}]' doc:name="Respuesta SOAP Contrato" doc:id="d11f7816-4d91-489a-ab2b-a8968ce147d3" />
		<error-handler>
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="144379f2-1363-4d7c-9cbc-654585fa6e63" type="ANY">
				<set-payload value="#[%dw 2.0&#10;output application/xml&#10;ns ns0 http://www.example.org/ServicioProcesoCierreIncidente/&#10;---&#10;{&#10;    body: {&#10;        ns0#CerrarResponse: {&#10;            ns0#incidenteCerrado: false,&#10;            ns0#error: error.description&#10;        }&#10;    }&#10;}]" doc:name="Respuesta SOAP Contrato" doc:id="ad316c9e-6679-4672-bf75-63e6ac899b32" />
			</on-error-continue>
		</error-handler>
    </flow>
	<sub-flow name="verificarIncidenteId" doc:id="baa8f5f6-0d0f-495d-bc7e-c3874eefed39" >
		<db:select doc:name="Select Incidente" doc:id="f931ae1b-d610-4c14-9500-b0207c94b87c" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT id, estado FROM incidente WHERE id = :incidenteId LIMIT 1]]></db:sql>
			<db:input-parameters ><![CDATA[#[{"incidenteId": payload}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Choice" doc:id="ae331e97-58d7-493a-ae25-44ddb1b62846" >
			<when expression='#[not isEmpty(payload) and upper(payload[0].estado as String) == "ACTIVO"]'>
				<logger level="INFO" doc:name="El incidente ya esta activo" doc:id="b213b62e-511e-457b-a591-479f7b4fc56d" message="El incidente ya esta activo"/>
			</when>
			<when expression='#[not isEmpty(payload) and upper(payload[0].estado as String) != "ACTIVO"]'>
				<raise-error doc:name="El incidente ya no esta activo" doc:id="2cf50941-0027-4134-84d2-b7e67d4a8f08" type="ANY" description="El incidente ya no esta activo"/>
			</when>
			<otherwise >
				<raise-error doc:name="Incidente no encontrado" doc:id="01778648-038a-4247-a32c-9e584c2c30df" type="ANY" description="Incidente no encontrado"/>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="crearExpediente" doc:id="975c121b-abd3-4857-a52e-452320eac6ff">
		<wsc:consume doc:name="Crear Expediente" doc:id="3a6c1ee0-de8b-4fe7-a622-c8d46ace86dc" config-ref="ServicioExpediente" operation="Crear">
			<wsc:message>
				<wsc:body><![CDATA[#[%dw 2.0
output application/xml
ns ser http://www.example.org/ServicioExpediente/
ns v1 http://example.org/emergencias/types/v1
---
{
    ser#Crear: {
        expediente: {
            v1#expedienteId: "",
            v1#incidenteId: payload
        }
    }
}]]]></wsc:body>
			</wsc:message>
		</wsc:consume>
		<ee:transform doc:name="Transform Message" doc:id="2f850a6a-03be-40c2-a5bd-79733ae31072" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
ns ns5 http://www.example.org/ServicioExpediente/
---
{
    expedienteId: payload.body.ns5#CrearResponse.expedienteId as Number,
    creado:       payload.body.ns5#CrearResponse.creado as Boolean,
    error:        payload.body.ns5#CrearResponse.error
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<choice doc:name="Choice" doc:id="a1bc1152-9f98-4de6-8077-29f74877472b" >
			<when expression="#[payload.creado]">
				<logger level="INFO" doc:name="Expediente creado correctamente" doc:id="200b611f-0352-4480-a22e-31706d0110dc" message="Expediente creado correctamente"/>
			</when>
			<otherwise >
				<raise-error doc:name="No se pudo crear el expediente" doc:id="55220930-17cc-4541-96d6-f2235517c9a2" type="ANY" description="No se pudo crear el expediente"/>
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="Logger" doc:id="8f5b1fe9-50f3-4cc6-9de0-9168ac59491a" message="#[payload]"/>
	</sub-flow>
	<sub-flow name="calcularParametros" doc:id="23e51016-9c6f-4d16-b8c5-71da5475ccea">
		<db:select doc:name="Select" doc:id="272c1d55-3a29-4631-811e-2c3f52f6ed88" config-ref="Database_Config">
			<db:sql><![CDATA[SELECT COUNT(*) as num, AVG(TIMESTAMPDIFF(MINUTE, hora_salida, hora_llegada)) as avg_tiempo, MAX(TIMESTAMPDIFF(MINUTE, hora_salida, hora_llegada)) as max_tiempo, SUM(CASE WHEN actuaciones IS NOT NULL AND actuaciones <> '' THEN 1 ELSE 0 END) as con_actuacion FROM dato_servicio WHERE expediente_id = :expedienteId]]></db:sql>
			<db:input-parameters><![CDATA[#[{"expedienteId": payload}]]]></db:input-parameters>
		</db:select>
		<ee:transform doc:name="Transform Message" doc:id="8e63a5da-d0bb-491e-8b7e-facefc572f59">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java

var row    = payload[0]
var num    = row.num
var avg    = row.avg_tiempo
var max    = row.max_tiempo
var conAct = row.con_actuacion

fun crearParametro(nombre, valor) = {
    nombre: nombre,
    valor: valor
}

fun formatDecimal(n) = 
    (n as String {format: "0.00"}) replace "," with "."

---
[
    crearParametro("numeroservicios", num as String),
    crearParametro("tiemporespuestapromedio", if (avg != null and avg >= 0) formatDecimal(avg) else "0.00"),
    crearParametro("tiemporespuestamaximo",   if (max != null and max >= 0) formatDecimal(max) else "0.00"),
    crearParametro("serviciosconactuacion", conAct as String)
]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="d0a018e1-1c85-432c-9846-4987816ec283" message="#[payload]" />
		<ee:transform doc:name="Transform Message" doc:id="859aa5b2-49af-4ea1-8448-02db1055b0bb">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/xml

ns ser http://www.example.org/ServicioParametros/
ns v1 http://example.org/emergencias/types/v1

---
ser#Calcular: {
    (payload map (p) -> {
        parametro: {
            v1#nombre: p.nombre,
            v1#valor: p.valor
        }
    })
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<wsc:consume doc:name="Consume" doc:id="82112448-90ea-4f76-b73d-7b7c90b820e1" config-ref="ServicioParametros" operation="Calcular" />
		<ee:transform doc:name="Transform Message" doc:id="df466f0f-b773-45d6-95bf-53d25b311c20">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
ns ns3 http://www.example.org/ServicioParametros/
ns ns1 http://example.org/emergencias/types/v1
---
{
    parametros: payload.body.ns3#CalcularResponse.*resultado map (r) -> {
        nombre: r.ns1#nombre,
        valor:  r.ns1#valor
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="b7cfe3f0-656d-48b0-9a6a-67b7de610b7a" message="#[payload]" />
	</sub-flow>
	<sub-flow name="verificarParametros" doc:id="16dbc2f1-7d64-476f-a522-536f3ef56ffb">
		<set-variable value="#[payload.parametros]" doc:name="Parametros" doc:id="b1c97bdb-d7ab-4406-90fc-c090ca3f2945" variableName="parametros"/>
		<set-variable value="#[false]" doc:name="Parametro fallido" doc:id="5295e340-449a-4d8a-908a-5b092a1a8e01" variableName="parametroFallido" />
