    </flow>
    <flow name="Cerrar:\soapkit-config">
		<set-variable value="#[%dw 2.0&#10;ns ns0 http://www.example.org/ServicioProcesoCierreIncidente/&#10;output application/java&#10;---&#10;payload.body.ns0#Cerrar.incidenteId]" doc:name="Incidente ID" doc:id="a2be5244-a53b-4d12-b7fc-5628b6dd823b" variableName="incidenteId"/>
		<set-payload value="#[vars.incidenteId]" doc:name="Incidente ID" doc:id="8c68db86-6aae-4fe5-8243-5b82ae9cda6e" />
		<flow-ref doc:name="Verificar Incidente" doc:id="30ae4897-6597-455f-bdd3-f813c32a54b0" name="verificarIncidenteId"/>
