		<flow-ref doc:name="Verificar Parametros" doc:id="dc0a4fe0-e665-4806-810d-a8da35f49a73" name="verificarParametros"/>
		<logger level="INFO" doc:name="Logger" doc:id="f24473f0-9a8f-43d2-945f-426460fe03da" />
		<choice doc:name="Choice" doc:id="b41587bf-79bf-401e-8f0d-58e0e078ddb9" >
			<when expression="#[payload.parametroFallido]">
				<set-payload value='#[{&#10;	"expedienteId": vars.expedienteId,&#10;	"parametros": vars.parametros&#10;}]' doc:name="Set expedienteID y parametros" doc:id="3fc948db-6970-48a1-9a20-3a25410c9220" />
				<flow-ref doc:name="Comprobar parametros" doc:id="c6021950-d8c3-4aa6-88be-38fad441c8a7" name="comprobarParametros" targetValue='#[vars.parametrosExpediente]'/>
				<flow-ref doc:name="Reverificar parametros" doc:id="49eae4ab-df71-4746-b186-b54952add4a7" name="verificarParametros" targetValue="#[vars.parametros]"/>
				<choice doc:name="Choice" doc:id="cd5aff11-3a92-405e-b930-2c2fec2f7222" >
