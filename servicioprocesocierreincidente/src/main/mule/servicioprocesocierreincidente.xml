		<wsc:consume doc:name="Obtener Datos Servicios" doc:id="467eab06-ea6b-4db7-ba35-fedfdffa0d54" config-ref="ServicioRecursos" operation="ObtenerDatos">
			<wsc:message>
				<wsc:body><![CDATA[#[%dw 2.0
output application/xml
ns ser http://www.example.org/ServicioRecursos/
---
{
    ser#ObtenerDatos: {
        expedienteId: payload.expedienteId
    }
}]]]></wsc:body>
			</wsc:message>
		</wsc:consume>
		<ee:transform doc:name="Transform Message" doc:id="30aad2cf-d870-4de1-a385-30c5948b5490" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
ns ns2 http://www.example.org/ServicioRecursos/
ns ns1 http://example.org/emergencias/types/v1
---
{
  datosServicios: payload.body.ns2#ObtenerDatosResponse.*datoServicio map (item, index) -> {
    servicio: item.ns1#servicio,
    horaSalida: item.ns1#horaSalida,
    actuaciones: item.ns1#actuaciones,
    recursosUtilizados: item.ns1#recursosUtilizados,
    observaciones: item.ns1#observaciones
  }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<set-variable value='#[%dw 2.0&#10;output text/plain&#10;var datos = payload.datosServicios&#10;---&#10;if (datos == null or isEmpty(datos))&#10;    "Ninguno."&#10;  else&#10;    (datos map ((ds) -&gt;&#10;      ds.servicio ++ ": " ++ (ds.recursosUtilizados default "N/A")&#10;    )) joinBy ". "]' doc:name="Resumen Recursos" doc:id="085ac742-ecd9-4eed-a88e-4ee30603c756" variableName="resumenRecursos"/>
		<set-variable value="#[sizeOf(payload.datosServicios default [])]" doc:name="Número de servicios" doc:id="64b5764c-bbf7-414e-a27c-90228a026c99" variableName="numServicios"/>
		<set-payload value="#[vars.expedienteId]" doc:name="Set Payload" doc:id="fa0fa774-b579-4b85-bad3-4fc762ba466c" />
		<flow-ref doc:name="Calcular Parametros" doc:id="bf397087-e478-45fc-a217-0e139d696f8b" name="calcularParametros"/>
		<logger level="INFO" doc:name="Logger" doc:id="74754aae-61fe-4a2c-bade-f11e1c803c9f" />
