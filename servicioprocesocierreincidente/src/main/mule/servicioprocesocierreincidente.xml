						<raise-error doc:name="Verificación de parametros inválida con reintento" doc:id="867c31be-012f-4a94-9b5f-6286eae3a777" type="ANY" description="Reverificación de parametros inválida con reintento"/>
					</when>
					<otherwise >
						<logger level="INFO" doc:name="Parametros verificados correctamente" doc:id="ffdf7c68-f782-4ddc-a15e-accdc8695b81" message="Parametros verificados correctamente"/>
					</otherwise>
				</choice>
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Parametros verificados correctamente" doc:id="8e16c792-a2a9-4144-a15e-516758bcf372" message="Parametros verificados correctamente"/>
			</otherwise>
		</choice>
		<set-variable value="#[payload.resumenParametros]" doc:name="Resumen parametros" doc:id="bd078e7f-15f7-4be8-b0d9-67322390ad2d" variableName="resumenParametros"/>
		<ee:transform doc:name="Transform Message" doc:id="5ba247fe-47cb-4e17-8f5a-14f3a57f6b35" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"incidenteId": vars.incidenteId,
	"expedienteId": vars.expedienteId,
	"resumenRecursos": vars.resumenRecursos,
	"resumenParametros": vars.resumenParametros
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Generar informe operativo" doc:id="eb22f7d7-ea22-4894-aa26-a5d763a78310" name="generarInformeOperativo"/>
		<ee:transform doc:name="Transform Message" doc:id="a3b7497c-3e42-48b4-b1f7-9b78d277e9f7" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"incidenteId": vars.incidenteId,
	"expedienteId": vars.expedienteId,
	"numRecursos": vars.numServicios,
	"resumenParametros": vars.resumenParametros
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Generar informe estrategico" doc:id="c000ecb9-d218-4641-98dd-870e82ca5401" name="generarInformeEstrategico"/>
		<set-payload value="#[%dw 2.0&#10;output application/xml&#10;ns ser http://www.example.org/ServicioExpediente/&#10;---&#10;ser#Archivar: {&#10;  expedienteId: vars.expedienteId&#10;}]" doc:name="Set Payload" doc:id="a74393be-de5e-44df-827c-4eaa0de55d03" />
		<wsc:consume operation="Archivar" doc:name="Archivar expediente" doc:id="772cff53-7db3-4187-9000-df4d6e8f7323" config-ref="ServicioExpediente">
		</wsc:consume>
		<ee:transform doc:name="Transform Message" doc:id="c785c69c-5bcf-4ef9-a337-9f13b9f3fc25" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
ns ns5 http://www.example.org/ServicioExpediente/
---
{
	archivado: payload.body.ns5#ArchivarResponse.archivado
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<choice doc:name="Choice" doc:id="d19cd9a1-1c91-46b8-a8d3-871a4db53bb1" >
