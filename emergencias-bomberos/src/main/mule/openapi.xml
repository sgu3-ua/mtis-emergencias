    <flow name="get:\parques\(id)\flota:openapi-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="id">attributes.uriParams.'id'</ee:set-variable>
            </ee:variables>
        </ee:transform>
		<db:select doc:name="Select" doc:id="17510522-c144-4754-96ef-2088b5913f88" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT idVehiculo, tipo, estado, matricula FROM vehiculo_bomberos WHERE parque_id = :idParque]]></db:sql>
			<db:input-parameters ><![CDATA[#[{'idParque': vars.id}]]]></db:input-parameters>
		</db:select>
		<ee:transform doc:name="Transform Message" doc:id="15341fed-8c88-4063-ad27-68f1fa93f449" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload map (vehiculo) -> {
    idVehiculo: vehiculo.idVehiculo,
    tipo: vehiculo.tipo,
    estado: vehiculo.estado,
    matricula: vehiculo.matricula
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
    </flow>
