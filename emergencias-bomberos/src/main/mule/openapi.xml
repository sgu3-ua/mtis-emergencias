    <flow name="post:\notificaciones\alerta-retraso:application\json:openapi-config">
		<set-variable value="#[payload]" doc:name="Set Variable" doc:id="7cf9ae1d-3892-4fad-af6e-31e410d379e1" variableName="payloadOriginal"/>
		<db:insert doc:name="Insert" doc:id="fe06c389-5825-4c3c-901e-251581e93fa4" config-ref="Database_Config">
			<db:sql ><![CDATA[INSERT INTO notificacion (incidente_id, mensaje, tipo) VALUES (:idIncidente, :mensaje, 'BOMBEROS')]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
    'idIncidente': vars.payloadOriginal.idIncidente,
    'mensaje': vars.payloadOriginal.mensaje default "El camión asignado no ha confirmado salida en el tiempo límite."
}]]]></db:input-parameters>
		</db:insert>
		<db:update doc:name="Update" doc:id="8bab7397-e244-4a53-b917-c8ec04a2929a" config-ref="Database_Config">
			<db:sql ><![CDATA[UPDATE incidente SET estado = 'BOMBEROS_ALERTA_RETRASO' WHERE id = :idIncidente]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
    'idIncidente': vars.payloadOriginal.idIncidente
}]]]></db:input-parameters>
		</db:update>
		<ee:transform doc:name="Transform Message" doc:id="3d0f0b44-9569-460d-8470-d6c1f1e5824b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "idIncidente": vars.payloadOriginal.idIncidente,
    "mensaje": "Alerta de retraso registrada correctamente"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
    </flow>
    <flow name="post:\despachos-bomberos:application\json:openapi-config">
