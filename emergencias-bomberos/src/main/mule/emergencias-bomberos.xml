    <flow name="post:\despachos-bomberos:application\json:openapi-config">
        <set-variable value="#[payload]" doc:name="Set Variable" variableName="payloadOriginal" />
		<set-variable value="#[payload]" doc:name="Set Variable" variableName="datosOriginales"/>
		<db:select doc:name="Select" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT COUNT(*) as existe FROM incidente WHERE id = :idincidente;]]></db:sql>
			<db:input-parameters ><![CDATA[#[{'idincidente': vars.payloadOriginal.idIncidente}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Choice" >
			<when expression="#[payload[0].existe &lt;= 0]">
				<ee:transform doc:name="Transform Message">
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "error": "No existe el incidente"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<set-variable value="404" doc:name="Set Variable" variableName="httpStatus"/>
			</when>
			<otherwise>
				<db:update doc:name="Incidente" config-ref="Database_Config">
			        <db:sql><![CDATA[UPDATE incidente SET requiere_bomberos = TRUE, urgencia = :gravedad, estado = 'BOMBEROS_DESPACHADOS' WHERE id = :idIncidente]]></db:sql>
			        <db:input-parameters><![CDATA[#[{
                        'gravedad': vars.payloadOriginal.gravedad,
                        'idIncidente': vars.payloadOriginal.idIncidente
                    }]]]></db:input-parameters>
		        </db:update>
				<db:insert doc:name="Despliegue" config-ref="Database_Config">
					<db:sql ><![CDATA[INSERT INTO registro_despliegue_bomberos (incidente_id, vehiculo_bomberos_id) VALUES (:incidente, :vehiculo);]]></db:sql>
					<db:input-parameters ><![CDATA[#[{ "incidente": vars.datosOriginales.idIncidente, "vehiculo": vars.datosOriginales.vehiculosRequeridos }]]]></db:input-parameters>
				</db:insert>
				<db:update doc:name="Camion" config-ref="Database_Config">
					<db:sql ><![CDATA[UPDATE vehiculo_bomberos SET estado = 'en_ruta' WHERE idVehiculo = :idVehiculo;]]></db:sql>
					<db:input-parameters ><![CDATA[#[{ "idVehiculo": vars.datosOriginales.vehiculosRequeridos }]]]></db:input-parameters>
				</db:update>

                <ee:transform doc:name="Payload Orden Movilizacion">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "idVehiculo": vars.datosOriginales.vehiculosRequeridos,
    "idIncidente": vars.datosOriginales.idIncidente
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
                <flow-ref doc:name="Llamar a orden movilizacion" name="post:\notificaciones\orden-movilizacion:application\json:openapi-config"/>
                
                <choice doc:name="Choice">
                    <when expression="#[random() &lt; 0.5]">
                        <ee:transform doc:name="Transform Message">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "idIncidente": vars.datosOriginales.idIncidente,
    "mensaje": "ALERTA RETRASO: El camión experimenta retenciones en la ruta calculada."
}]]></ee:set-payload>
                            </ee:message>
                        </ee:transform>
                        <flow-ref doc:name="Redirigir a alerta retraso" name="post:\notificaciones\alerta-retraso:application\json:openapi-config"/>
                    </when>
                </choice>

				<db:insert doc:name="Insert" config-ref="Database_Config">
			        <db:sql><![CDATA[INSERT INTO notificacion (incidente_id, mensaje, tipo) VALUES (:idIncidente, :mensaje, 'BOMBEROS')]]></db:sql>
			        <db:input-parameters><![CDATA[#[{
                        "idIncidente": vars.datosOriginales.idIncidente,
                        "mensaje": "Orquestación completada: Despacho de bomberos automático y vehículo movilizado."
                    }]]]></db:input-parameters>
		        </db:insert>

				<ee:transform doc:name="Transform Message">
			        <ee:message>
				        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "status": "ÉXITO",
    "idIncidente": vars.datosOriginales.idIncidente,
    "mensaje": "Orquestación completada en cadena de forma exitosa."
}]]></ee:set-payload>
			        </ee:message>
		        </ee:transform>
			</otherwise>
		</choice>
		<error-handler >
